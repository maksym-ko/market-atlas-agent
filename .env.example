ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# comma-separated origins allowed to make state-changing requests (CSRF check)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# LangSmith tracing (optional). In privacy_mode: strict, trace inputs/outputs are hidden automatically.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=market-atlas-agent
# curator page /admin (disabled when empty) and the session cookie secret
ADMIN_PASSWORD=
STORAGE_SECRET=
# OpenAI-compatible endpoint /v1 for Open WebUI (disabled when empty)
OPENAI_COMPAT_KEY=
# web research (research_external tool)
TAVILY_API_KEY=
# comma-separated names removed from web queries (clients, internal datasets)
PRIVATE_TERMS=
# where tools run: mcp (MCP servers over stdio) or inproc
TOOLS_TRANSPORT=mcp
# local models (provider: ollama in models.yaml); in Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# semantic indicator search (make index); used only in privacy_mode: demo
PINECONE_API_KEY=
PINECONE_INDEX=market-atlas-indicators
